# ---- Recognition backend ----
# "shazamio" = free local Shazam service (see recognizer/). "audd" = paid API.
RECOGNIZER=shazamio
SHAZAMIO_URL=http://127.0.0.1:3251/recognize

# Only needed if RECOGNIZER=audd. Token at https://dashboard.audd.io/
AUDD_API_TOKEN=

# ---- Listener auth (recommended) ----
# A shared secret the /listen device must enter so randoms can't push fake songs.
# Leave blank to disable the check (fine for local testing).
LISTENER_SECRET=

# ---- Persistence (recommended for Vercel) ----
# Without these, "now playing" is kept in memory and is lost when the serverless
# function recycles. Create a free Redis DB at https://upstash.com or via the
# Vercel Marketplace, then paste the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
